<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HomeTaste</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <!-- Google Material Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

    <!-- Your custom CSS -->
    <link rel="stylesheet" href="~/css/guest.css" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg shadow-sm px-4" style="background-color: var(--ht-primary-container);">
        <a class="navbar-brand fw-bold text-white" href="/">HomeTaste</a>
        <div class="ms-auto d-flex gap-2">
            
            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Host"))
                {
                    <a href="/host/dish" class="ht-nav-btn">Host Portal</a>
                }
                else
                {
                    <a href="/host/host/join" class="ht-nav-btn">Join as Host</a>
                    <a href="/guest/booking/mybookings" class="ht-nav-btn">My Bookings</a>
                }
                <!-- js-logout-form: the script at the bottom asks for confirmation first.
                     returnUrl = "/" sends the user to the guest home page after logout. -->
                <form action="/Identity/Account/Logout" method="post" class="d-inline js-logout-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="/" />
                    <button type="submit" class="ht-nav-btn">Logout</button>
                </form>
            }
            else
            {
                <a href="/host/host/join" class="ht-nav-btn">Join as Host</a>
                <a href="/Identity/Account/Login" class="ht-nav-btn">Login</a>
                <a href="/Identity/Account/Register" class="ht-nav-btn">Sign Up</a>
            }
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="text-center py-4 mt-5 bg-light text-muted">
        <p>© 2024 HomeTaste. All rights reserved.</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert2 library (for the nice confirmation popup) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Ask the user to confirm before logging out
        document.querySelectorAll(".js-logout-form").forEach(function (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault(); // stop the normal submit so we can show the popup first

                Swal.fire({
                    title: "Log out?",
                    text: "You will need to log in again to book meals.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonColor: "#D17132",
                    cancelButtonColor: "#8d7168",
                    confirmButtonText: "Yes, log out",
                    cancelButtonText: "Stay logged in"
                }).then(function (result) {
                    // Only log out if the user clicked the confirm button
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>

</body>
</html>