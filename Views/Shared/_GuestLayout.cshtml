<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HomeTaste</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <!-- Google Material Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

    <!-- Your custom CSS -->
    <link rel="stylesheet" href="~/css/guest.css" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm px-4">
        <a class="navbar-brand fw-bold" href="/">HomeTaste</a>
        <div class="ms-auto d-flex gap-2">
            
            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Host"))
                {
                    <a href="/host/dish" class="btn btn-outline-secondary">My Dishes</a>
                    <a href="/host/booking/managebookings" class="btn btn-outline-secondary">My Bookings</a>
                }
                else
                {
                    <a href="/host/host/join" class="btn btn-outline-success">Join as Host</a>
                    <a href="/guest/booking/mybookings" class="btn btn-outline-secondary">My Bookings</a>
                }
                <form action="/Identity/Account/Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Logout</button>
                </form>
            }
            else
            {
                <a href="/host/host/join" class="btn btn-outline-success">Join as Host</a>
                <a href="/Identity/Account/Login" class="btn btn-outline-secondary">Login</a>
                <a href="/Identity/Account/Register" class="btn btn2 btn-warning fw-bold">Sign Up</a>
            }
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="text-center py-4 mt-5 bg-light text-muted">
        <p>© 2024 HomeTaste. All rights reserved.</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>