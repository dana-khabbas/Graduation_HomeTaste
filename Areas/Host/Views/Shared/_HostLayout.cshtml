<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeTaste Host</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <!-- We reuse the same admin stylesheet (same theme/colours) -->
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>

    <!-- ===== SIDEBAR ===== -->
    <aside class="adm-sidebar d-flex flex-column p-3">

        <!-- Brand (HomeTaste is a link back to the home page) -->
        <div class="mb-4 px-2">
            <a href="/" class="text-decoration-none">
                <h1 class="adm-brand-name">HomeTaste</h1>
            </a>
            <p class="adm-portal-label">Host Portal</p>
        </div>

        <!-- Nav Links (no Dashboard here) -->
        <nav class="flex-grow-1">
            <a href="@Url.Action("Index", "Dish", new { area = "Host" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Dishes" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">restaurant_menu</span>
                <span>My Dishes</span>
            </a>

            <a href="@Url.Action("ManageBookings", "Booking", new { area = "Host" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Bookings" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">calendar_today</span>
                <span>Bookings</span>
            </a>

            <a href="@Url.Action("Index", "Review", new { area = "Host" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Reviews" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">star</span>
                <span>Reviews</span>
            </a>
        </nav>

        <!-- Logout -->
        <div class="adm-sidebar-footer">
            <!-- js-logout-form: the script at the bottom asks for confirmation first.
                 returnUrl = "/" sends the user to the guest home page after logout. -->
            <form action="/Identity/Account/Logout" method="post" id="logoutForm" class="d-inline w-100 js-logout-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/" />
                <button type="submit" class="adm-nav-link border-0 bg-transparent w-100 text-start d-flex align-items-center gap-2" style="cursor: pointer;">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>

    </aside>

    <!-- ===== MAIN WRAPPER ===== -->
    <div class="adm-main-wrapper">
        <main class="adm-main-content">
            @RenderBody()
        </main>

        <!-- ===== FOOTER ===== -->
        <footer class="adm-footer">
            <div class="container-fluid px-4">
                <div class="adm-footer-bar d-flex justify-content-between align-items-center flex-wrap gap-3 py-4">
                    <p class="adm-footer-copy mb-0">© 2024 HomeTaste. A warm seat at every table.</p>
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert2 library (for the nice confirmation popup) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Ask the user to confirm before logging out
        document.querySelectorAll(".js-logout-form").forEach(function (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                Swal.fire({
                    title: "Log out?",
                    text: "You will be returned to the home page.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonColor: "#D17132",
                    cancelButtonColor: "#8d7168",
                    confirmButtonText: "Yes, log out",
                    cancelButtonText: "Stay logged in"
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
