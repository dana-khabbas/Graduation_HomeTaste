@model IEnumerable<graduation_proj.Models.Review>

@{
    ViewData["Title"] = $"Reviews for {ViewBag.DishName}";
    ViewData["ActivePage"] = "Reviews";
}

<h1 class="adm-page-title">Reviews for @ViewBag.DishName</h1>
<p class="adm-page-subtitle mb-4">Only the reviews for this one dish.</p>

@if (!Model.Any())
{
    <div class="adm-card text-center">
        <p class="adm-page-subtitle mb-0">No reviews have been left for this dish yet.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var review in Model)
        {
            <div class="col-12">
                <div class="adm-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <!-- Reviewer name -->
                        <h5 class="adm-card-title mb-0">@(review.Guest?.FullName ?? "Anonymous Guest")</h5>
                        <span class="badge bg-secondary">@review.CreatedAt.ToShortDateString()</span>
                    </div>

                    <!-- Star rating -->
                    <div class="text-warning my-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span>@(i <= review.Rating ? "★" : "☆")</span>
                        }
                    </div>

                    <p class="mb-0 fst-italic">"@review.Comment"</p>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4">
    <a asp-action="Index" asp-controller="Dish" asp-area="Host" class="adm-btn-outline">Back to My Dishes</a>
</div>
