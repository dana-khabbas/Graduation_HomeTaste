@model IEnumerable<graduation_proj.Models.Review>

@{
    ViewData["Title"] = "All My Reviews";
    ViewData["ActivePage"] = "Reviews"; // highlights "Reviews" in the sidebar
}

<h1 class="adm-page-title">Reviews From Guests</h1>
<p class="adm-page-subtitle mb-4">Here is what guests are saying about your dishes.</p>

@if (!Model.Any())
{
    <div class="adm-card text-center">
        <p class="adm-page-subtitle mb-0">You haven't received any reviews yet.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var review in Model)
        {
            <div class="col-12">
                <div class="adm-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <!-- Reviewer name -->
                            <h5 class="adm-card-title mb-1">@(review.Guest?.FullName ?? "Anonymous Guest")</h5>

                            <!-- Star rating -->
                            <div class="text-warning mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= review.Rating ? "★" : "☆")</span>
                                }
                                <span class="adm-dish-host ms-1">(@review.Rating/5)</span>
                            </div>
                        </div>
                        <span class="badge bg-secondary">@review.CreatedAt.ToShortDateString()</span>
                    </div>

                    <p class="adm-dish-host text-uppercase mb-1">Review for: @review.Dish?.Name</p>
                    <p class="mb-0 fst-italic">"@review.Comment"</p>
                </div>
            </div>
        }
    </div>
}
