@model graduation_proj.Models.Dish

@{
    ViewData["Title"] = "Dish Details";
    ViewData["ActivePage"] = "Dishes";
}

<h1 class="adm-page-title">Dish Details</h1>
<p class="adm-page-subtitle mb-4">A full look at this dish.</p>

<div class="row g-4">

    <!-- Dish photo -->
    <div class="col-12 col-md-5">
        <div class="adm-card">
            @if (!string.IsNullOrEmpty(Model.DishPicturePath))
            {
                <img src="@Model.DishPicturePath" alt="@Model.Name" style="width:100%; border-radius:8px;" />
            }
            else
            {
                <div style="width:100%; height:220px; background:#f0f0f0; border-radius:8px;"></div>
            }
        </div>
    </div>

    <!-- Dish info -->
    <div class="col-12 col-md-7">
        <div class="adm-card">
            <h2 class="adm-card-title">@Model.Name</h2>
            <p class="adm-dish-orders mb-3" style="font-size:22px;">$@Model.Price</p>

            <p class="mb-3">@Model.Description</p>
            <p class="adm-dish-host text-uppercase mb-4">Serves @Model.ServesPersons persons</p>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.DishId" class="adm-btn-primary">Edit</a>
                <a asp-action="Index" class="adm-btn-outline">Back to List</a>
            </div>
        </div>
    </div>

</div>
