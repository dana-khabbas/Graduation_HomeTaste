@model graduation_proj.Models.Dish

<h2>Add New Dish</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" required />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" required></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" required />
        <span asp-validation-for="Price"></span>
    </div>
    <div>
        <label asp-for="ServesPersons">Serves (Number of People)</label>
        <input asp-for="ServesPersons" type="number" min="1" required />
        <span asp-validation-for="ServesPersons"></span>
    </div>
    <div>
        <label>Dish Picture</label>
        <input type="file" name="dishPicture" accept="image/*" />
    </div>
    <br />
    <button type="submit">Save Dish</button>
</form>