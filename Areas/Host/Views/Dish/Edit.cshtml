@model graduation_proj.Models.Dish

<h2>Edit Dish</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="DishId" />
    <input type="hidden" asp-for="HostProfileId" />
    <input type="hidden" asp-for="DishPicturePath" />

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" required />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" required></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" required />
        <span asp-validation-for="Price"></span>
    </div>
    <div>
        <label asp-for="ServesPersons"></label>
        <input asp-for="ServesPersons" type="number" min="1" required />
        <span asp-validation-for="ServesPersons"></span>
    </div>

    <div>
        <label>Change Dish Picture (Optional)</label>
        <input type="file" name="dishPicture" accept="image/*" />
        @if (!string.IsNullOrEmpty(Model.DishPicturePath))
        {
            <p>Current picture: <img src="@Model.DishPicturePath" width="100" /></p>
        }
    </div>

    <br />
    <button type="submit">Save Changes</button>
</form>