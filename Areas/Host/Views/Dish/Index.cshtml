@model IEnumerable<graduation_proj.Models.Dish>

@{
    ViewData["Title"] = "My Dishes";
}

<h2>My Dishes</h2>
<a asp-action="Create">Add New Dish</a>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Serves</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dish in Model)
        {
            <tr>
                <td>
    @if (!string.IsNullOrEmpty(dish.DishPicturePath))
    {
        <img src="@dish.DishPicturePath" alt="@dish.Name" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px;" />
    }
    else
    {
        <span>No Image</span>
    }
</td>
                <td>@dish.Name</td>
                <td>@dish.Price</td>
                <td>@dish.ServesPersons</td>
                <td>
                    <a asp-action="Details" asp-route-id="@dish.DishId">Details</a>
                    <a asp-action="Edit" asp-route-id="@dish.DishId">Edit</a>
                    <a asp-action="Delete" asp-route-id="@dish.DishId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>