@{
    ViewBag.Title = "Authentic Homemade Food";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
}

<!-- ===== HERO SECTION ===== -->
<section class="ht-hero position-relative overflow-hidden">

    <!-- Background Image with overlay -->
    <div class="ht-hero-bg"></div>
    <div class="ht-hero-overlay"></div>

    <!-- Hero Content -->
    <div class="ht-hero-content text-center text-white">
        <h1 class="ht-hero-title">
            Taste authentic homemade food from locals around the world
        </h1>

        <!-- Search Bar -->
        <div class="ht-search-bar mx-auto">
            <div class="row g-0 align-items-center h-100">

                <div class="col-12 col-md d-flex flex-column px-3 py-2 ht-search-field border-end">
                    <label class="ht-search-label">COUNTRY</label>
                    <select class="ht-search-select">
                        <option>Anywhere</option>
                        <option>Italy</option>
                        <option>Thailand</option>
                        <option>Mexico</option>
                    </select>
                </div>

                <div class="col-12 col-md d-flex flex-column px-3 py-2 ht-search-field border-end">
                    <label class="ht-search-label">CITY</label>
                    <select class="ht-search-select">
                        <option>All Cities</option>
                        <option>Rome</option>
                        <option>Bangkok</option>
                        <option>Oaxaca</option>
                    </select>
                </div>

                <div class="col-12 col-md d-flex flex-column px-3 py-2 ht-search-field">
                    <label class="ht-search-label">GUESTS</label>
                    <select class="ht-search-select">
                        <option>1 Guest</option>
                        <option>2 Guests</option>
                        <option>4+ Guests</option>
                    </select>
                </div>

                <div class="col-auto px-3">
                    <button class="btn ht-search-btn">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ===== EXPERIENCES GRID SECTION ===== -->
<section class="container-xl px-4 py-5 mt-3">

    <!-- Section Header + Sort -->
