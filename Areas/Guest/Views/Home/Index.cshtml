<!-- ===== HOST PROMO SECTION ===== -->
<section class="ht-host-promo py-5">
    <div class="container-xl px-4">
        <div class="row align-items-center g-5">

            <!-- Image Side -->
            <div class="col-12 col-md-6 position-relative">
                <div class="ht-promo-img-wrap">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBftCEKbuEVJffixzUtk_L9zGMUvm3ALZ9QAFDq8NRpw3cIo9M9WaziRRZlgtqFqzNc6o4F2s8PPybXE7vfTcMwP1KOwX9QyC1YSA0zlzGtoMRX-XroU7zuJR-GCWwWI39pRpl2jNtIMD7Jmx5lg-0myBsFkEKCCKkZffLfvqiKva9ukHyq286ET5lF3jFOIzs25s2NdQFQ_c_pWG98ajkBt9MgVwKg0zUbQ7EXLTy3Y4Ip4_9gOhQBppY7rAUCA7tw1XxYGIMixeQ"
                         alt="Host in her kitchen" class="ht-promo-img" />
                </div>
                <!-- Quote Card -->
                <div class="ht-quote-card">
                    <p class="ht-quote-text">"I love sharing my grandmother's recipes with the world."</p>
                    <p class="ht-quote-author">— Maria, Host in Florence</p>
                </div>
            </div>

            <!-- Text Side -->
            <div class="col-12 col-md-6">
                <h2 class="ht-promo-title">Open your kitchen, share your culture</h2>
                <p class="ht-promo-subtitle">
                    Join thousands of hosts worldwide who are turning their dining tables into global meeting places.
                    Earn money while doing what you love—cooking.
                </p>
                <ul class="list-unstyled ht-benefit-list mb-4">
                    <li>
                        <span class="material-symbols-outlined ht-check-icon">check_circle</span>
                        Set your own price and schedule
                    </li>
                    <li>
                        <span class="material-symbols-outlined ht-check-icon">check_circle</span>
                        Verified guest booking system
                    </li>
                    <li>
                        <span class="material-symbols-outlined ht-check-icon">check_circle</span>
                        Insurance and 24/7 host support
                    </li>
                </ul>
                <button class="btn ht-btn-primary ht-btn-lg">Start Your Hosting Journey</button>
            </div>

        </div>
    </div>
</section>