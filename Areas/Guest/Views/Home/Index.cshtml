            <h2 class="ht-section-title">Popular experiences nearby</h2>
            <p class="ht-section-subtitle">Hand-picked authentic meals hosted in local homes.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="ht-sort-label">SORT BY</span>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn ht-sort-btn ht-sort-btn--active">Most Booked</button>
                <button class="btn ht-sort-btn">Price</button>
                <button class="btn ht-sort-btn">Rating</button>
            </div>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="row g-4">

        <!-- Card 1 -->
        <div class="col-12 col-sm-6 col-lg-3">
