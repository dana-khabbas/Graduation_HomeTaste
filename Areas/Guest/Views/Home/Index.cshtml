                         alt="Nonna's Secret Carbonara" class="ht-card-img" />
                    <div class="ht-card-rating">
                        <span class="material-symbols-outlined ht-star-icon">star</span>
                        <span>4.9</span>
                    </div>
                </div>
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h5 class="ht-card-title">Nonna's Secret Carbonara</h5>
                        <span class="ht-card-price">$32</span>
                    </div>
                    <p class="ht-card-location">Rome, Italy • 4 Guests max</p>
