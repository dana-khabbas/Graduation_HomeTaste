@{
    ViewBag.Title = "Authentic Homemade Food";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
}
@model IEnumerable<graduation_proj.Models.Dish>

<!-- ===== HERO SECTION ===== -->
<section class="ht-hero position-relative overflow-hidden">

    <!-- Background Image with overlay -->
    <div class="ht-hero-bg"></div>
    <div class="ht-hero-overlay"></div>

    <!-- Hero Content -->
    <div class="ht-hero-content text-center text-white">
        <h1 class="ht-hero-title">
            Taste authentic homemade food from locals around the world
        </h1>

        <!-- Search Bar: a GET form that sends the chosen filters to the Index action.
             The dropdown options below are built from the database (ViewBag). -->
        <form asp-area="Guest" asp-controller="Home" asp-action="Index" method="get" class="ht-search-bar mx-auto">
            <div class="row g-0 align-items-center h-100">

                <div class="col-12 col-md d-flex flex-column px-3 py-2 ht-search-field border-end">
                    <label class="ht-search-label">COUNTRY</label>
                    <select name="country" class="ht-search-select">
                        <option>Anywhere</option>
                        @foreach (var c in ViewBag.Countries)
                        {
                            <option selected="@(ViewBag.SelectedCountry == c ? "selected" : null)">@c</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md d-flex flex-column px-3 py-2 ht-search-field border-end">
                    <label class="ht-search-label">CITY</label>
                    <select name="city" class="ht-search-select">
                        <option>All Cities</option>
                        @foreach (var c in ViewBag.Cities)
                        {
                            <option selected="@(ViewBag.SelectedCity == c ? "selected" : null)">@c</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md d-flex flex-column px-3 py-2 ht-search-field">
                    <label class="ht-search-label">GUESTS</label>
                    <select name="guests" class="ht-search-select">
                        <option value="">Any</option>
                        <option value="1" selected="@(ViewBag.SelectedGuests == 1 ? "selected" : null)">1 Guest</option>
                        <option value="2" selected="@(ViewBag.SelectedGuests == 2 ? "selected" : null)">2 Guests</option>
                        <option value="4" selected="@(ViewBag.SelectedGuests == 4 ? "selected" : null)">4+ Guests</option>
                    </select>
                </div>

                <div class="col-auto px-3">
                    <button type="submit" class="btn ht-search-btn">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>

            </div>
        </form>
    </div>
</section>

<!-- ===== EXPERIENCES GRID SECTION ===== -->
<section class="container-xl px-4 py-5 mt-3">

    <!-- Section Header + Sort -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-4">
        <div>
            <h2 class="ht-section-title">Popular experiences nearby</h2>
            <p class="ht-section-subtitle">Hand-picked authentic meals hosted in local homes.</p>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="ht-sort-label">SORT BY</span>
            <div class="d-flex gap-2 flex-wrap">
                <!-- Each sort link keeps the current search filters and just changes the sort -->
                <a asp-area="Guest" asp-controller="Home" asp-action="Index"
                   asp-route-country="@ViewBag.SelectedCountry" asp-route-city="@ViewBag.SelectedCity"
                   asp-route-guests="@ViewBag.SelectedGuests" asp-route-sort="most"
                   class="btn ht-sort-btn @(ViewBag.Sort != "price" && ViewBag.Sort != "rating" ? "ht-sort-btn--active" : "")">Most Booked</a>

                <a asp-area="Guest" asp-controller="Home" asp-action="Index"
                   asp-route-country="@ViewBag.SelectedCountry" asp-route-city="@ViewBag.SelectedCity"
                   asp-route-guests="@ViewBag.SelectedGuests" asp-route-sort="price"
                   class="btn ht-sort-btn @(ViewBag.Sort == "price" ? "ht-sort-btn--active" : "")">Price</a>

                <a asp-area="Guest" asp-controller="Home" asp-action="Index"
                   asp-route-country="@ViewBag.SelectedCountry" asp-route-city="@ViewBag.SelectedCity"
                   asp-route-guests="@ViewBag.SelectedGuests" asp-route-sort="rating"
                   class="btn ht-sort-btn @(ViewBag.Sort == "rating" ? "ht-sort-btn--active" : "")">Rating</a>
            </div>
        </div>
    </div>

    <!-- Cards Grid -->
    @if (!Model.Any())
    {
        <p class="ht-section-subtitle">No dishes match your search. Try different options.</p>
    }
    <div class="row g-4">
    @foreach (var dish in Model)
    {
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="ht-card h-100">
                <div class="ht-card-img-wrap">
                    @if (dish.DishPicturePath != null)
                    {
                        <img src="@dish.DishPicturePath" alt="@dish.Name" class="ht-card-img" style="width:100%; height:200px; object-fit:cover;" />
                    }
                    else
                    {
                        <div style="width:100%; height:200px; background:#f0f0f0;"></div>
                    }
                </div>
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h5 class="ht-card-title">@dish.Name</h5>
                        <span class="ht-card-price">$@dish.Price</span>
                    </div>
                    <p class="ht-card-location">@dish.HostProfile?.City • @dish.ServesPersons Guests max</p>
                    <p class="ht-card-location">Booked @dish.TimesBooked times</p>
                    <a href="/guest/home/dishdetails/@dish.DishId" class="btn btn-warning btn-sm mt-2">View Dish</a>
                </div>
            </div>
        </div>
    }
</div> 
<!-- Discover more Button -->
    <div class="text-center mt-5">
        <button class="btn ht-btn-discover">Discover More Experiences</button>
    </div>

</section>

<!-- ===== HOST PROMO SECTION ===== -->
<section class="ht-host-promo py-5">
    <div class="container-xl px-4">
        <div class="row align-items-center g-5">

            <!-- Image Side -->
            <div class="col-12 col-md-6 position-relative">
                <div class="ht-promo-img-wrap">
                    <img src="/images/cooking-host.png" alt="Host in her kitchen" class="ht-promo-img" />
                </div>
                <!-- Quote Card -->
                <div class="ht-quote-card">
                    <p class="ht-quote-text">"The act of preparing food and feeding others is the most fundamental of all human behaviors."</p>
                    <p class="ht-quote-author">— Charlie Trotter</p>
                </div>
            </div>

            <!-- Text Side -->
            <div class="col-12 col-md-6">
                <h2 class="ht-promo-title">Open your kitchen, share your culture</h2>
                <p class="ht-promo-subtitle">
                    Join thousands of hosts worldwide who are turning their dining tables into global meeting places.
                    Earn money while doing what you love—cooking.
                </p>
                <ul class="list-unstyled ht-benefit-list mb-4">
                    <li>
                        <span class="material-symbols-outlined ht-check-icon">check_circle</span>
                        Set your own price and schedule
                    </li>
                    <li>
                        <span class="material-symbols-outlined ht-check-icon">check_circle</span>
                        Verified guest booking system
                    </li>
                    <li>
                        <span class="material-symbols-outlined ht-check-icon">check_circle</span>
                        Insurance and 24/7 host support
                    </li>
                </ul>
                @if (User.IsInRole("Host"))
                {
                    <!-- Already a host: go straight to the host portal -->
                    <a asp-area="Host" asp-controller="Dish" asp-action="Index" class="btn ht-btn-primary ht-btn-lg">
                        Start Your Hosting Journey
                    </a>
                }
                else
                {
                    <a asp-area="Host" asp-controller="Host" asp-action="Join" class="btn ht-btn-primary ht-btn-lg">
                        Start Your Hosting Journey
                    </a>
                }
            </div>

        </div>
    </div>
</section>