@model IEnumerable<graduation_proj.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";

    // Dish IDs the guest already reviewed
    var reviewedDishIds = ViewBag.ReviewedDishIds as List<int?> ?? new List<int?>();
}

<section class="container-xl px-4 py-5">

    <h2 class="ht-section-title">My Bookings</h2>
    <p class="ht-section-subtitle mb-4">All the visits you have requested.</p>

    @if (!Model.Any())
    {
        <!-- Shown when the guest has not booked anything yet -->
        <div class="ht-card p-5 text-center">
            <p class="ht-section-subtitle mb-0">You have no bookings yet.</p>
        </div>
    }
    else
    {
        <!-- White card wrapping the table -->
        <div class="ht-card p-4">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="ht-card-location text-uppercase">
                        <th>Dish</th>
                        <th>Host</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Persons</th>
                        <th>Status</th>
                        <th>Host Contact</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td class="fw-bold">@booking.Dish?.Name</td>
                            <td>@booking.Dish?.HostProfile?.User?.FullName</td>
                            <td>@booking.VisitDate.ToShortDateString()</td>
                            <td>@booking.VisitTime</td>
                            <td>@booking.NumberOfPersons</td>
                            <td>
                                <!-- Colour the status so it is easy to read -->
                                @if (booking.Status == graduation_proj.Models.BookingStatus.Confirmed)
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (booking.Status == graduation_proj.Models.BookingStatus.Cancelled)
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @{
                                    var mapLink = booking.Dish?.HostProfile?.Location;
                                    if (!string.IsNullOrEmpty(mapLink) && !mapLink.StartsWith("http"))
                                    {
                                        mapLink = "https://" + mapLink;
                                    }
                                }
                                @if (!string.IsNullOrEmpty(mapLink))
                                {
                                    <a href="@mapLink" target="_blank" rel="noopener noreferrer"
                                       class="d-block mb-1" style="color: var(--ht-primary);">
                                        View on Google Maps
                                    </a>
                                }
                                <span class="ht-card-location">
                                    @(booking.Dish?.HostProfile?.PhoneNumber ?? "—")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <!-- Confirmed visit: show review button only if not reviewed yet -->
                                    @if (booking.Status == graduation_proj.Models.BookingStatus.Confirmed && booking.DishId.HasValue)
                                    {
                                        @if (reviewedDishIds.Contains(booking.DishId))
                                        {
                                            <span class="badge bg-success">Reviewed</span>
                                        }
                                        else
                                        {
                                            <a asp-area="Guest" asp-controller="Review" asp-action="Create"
                                               asp-route-dishId="@booking.DishId"
                                               class="btn ht-btn-primary btn-sm">Leave Review</a>
                                        }
                                    }

                                    <!-- Only pending bookings can be cancelled -->
                                    @if (booking.Status == graduation_proj.Models.BookingStatus.Pending)
                                    {
                                        <form asp-action="Cancel" method="post" class="js-cancel-form">
                                            <input type="hidden" name="id" value="@booking.BookingId" />
                                            <button type="submit" class="btn ht-btn-outline btn-sm">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<!-- SweetAlert2 library (for the nice confirmation popup) -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Ask the user to confirm before a booking is cancelled (deleted)
    document.querySelectorAll(".js-cancel-form").forEach(function (form) {
        form.addEventListener("submit", function (e) {
            e.preventDefault(); // stop the normal submit so we can show the popup first

            Swal.fire({
                title: "Cancel this booking?",
                text: "This will permanently remove the booking.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#D17132",
                cancelButtonColor: "#8d7168",
                confirmButtonText: "Yes, cancel it",
                cancelButtonText: "Keep it"
            }).then(function (result) {
                // Only submit (delete) if the user clicked the confirm button
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });

    // Success popup after a review was submitted
    @if (TempData["ReviewSuccess"] != null)
    {
        <text>
        Swal.fire({
            title: "Review submitted!",
            text: "Thank you for sharing your experience.",
            icon: "success",
            confirmButtonColor: "#D17132"
        });
        </text>
    }

    // Error popup if they already reviewed this dish
    @if (TempData["ReviewError"] != null)
    {
        <text>
        Swal.fire({
            title: "Already reviewed",
            text: "@TempData["ReviewError"]",
            icon: "info",
            confirmButtonColor: "#D17132"
        });
        </text>
    }
</script>
