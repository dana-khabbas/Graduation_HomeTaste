@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
}

<section class="container-xl px-4 py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">

            <!-- White card holding the register form -->
            <div class="ht-card p-4 p-md-5">

                <h2 class="ht-section-title mb-1">Create your account</h2>
                <p class="ht-section-subtitle mb-4">Join HomeTaste and start booking meals.</p>

                <form method="post">
                    <!-- Shows general errors (like email already taken) -->
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-bold">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" required />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-bold">Password</label>
                        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" required />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn ht-btn-primary w-100">Create Account</button>
                </form>

                <!-- Link to the login page -->
                <p class="ht-section-subtitle mt-4 mb-0 text-center">
                    Already have an account?
                    <a asp-area="Identity" asp-page="/Account/Login" class="fw-bold" style="color: var(--ht-primary);">Log in</a>
                </p>

            </div>
        </div>
    </div>
</section>
