@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
}

<section class="container-xl px-4 py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">

            <!-- Simple "you are signed out" card -->
            <div class="ht-card p-4 p-md-5 text-center">
                <h2 class="ht-section-title">Signed out</h2>
                <p class="ht-section-subtitle mb-4">You have been logged out of HomeTaste.</p>
                <a href="/" class="btn ht-btn-primary">Back to Home</a>
            </div>

        </div>
    </div>
</section>
