@model IEnumerable<graduation_proj.Models.Dish>

@{
    ViewData["Title"] = "Pending Dishes";
    ViewData["ActivePage"] = "Dishes";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="adm-page-title">Pending Dishes</h1>
<p class="adm-page-subtitle mb-4">New dishes waiting for your approval.</p>

@if (!Model.Any())
{
    <div class="adm-card text-center">
        <p class="adm-page-subtitle mb-0">No dishes waiting for approval.</p>
    </div>
}
else
{
    <div class="adm-card">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="adm-dish-host text-uppercase">
                    <th>Photo</th>
                    <th>Dish</th>
                    <th>Price</th>
                    <th>Host</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dish in Model)
                {
                    <tr>
                        <td>
                            <div class="adm-dish-thumb">
                                @if (!string.IsNullOrEmpty(dish.DishPicturePath))
                                {
                                    <img src="@dish.DishPicturePath" alt="@dish.Name" />
                                }
                            </div>
                        </td>
                        <td>
                            <p class="adm-dish-name mb-0">@dish.Name</p>
                            <small class="adm-dish-host">Serves @dish.ServesPersons</small>
                        </td>
                        <td>$@dish.Price</td>
                        <td>@dish.HostProfile?.User?.FullName</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <form asp-action="Approve" method="post">
                                    <input type="hidden" name="id" value="@dish.DishId" />
                                    <button type="submit" class="adm-btn-primary btn-sm">Approve</button>
                                </form>
                                <form asp-action="Delete" method="post" class="js-delete-dish">
                                    <input type="hidden" name="id" value="@dish.DishId" />
                                    <button type="submit" class="adm-btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll(".js-delete-dish").forEach(function (form) {
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            Swal.fire({
                title: "Delete this dish?",
                text: "It will be removed permanently.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#D17132",
                cancelButtonColor: "#8d7168",
                confirmButtonText: "Yes, delete"
            }).then(function (result) {
                if (result.isConfirmed) form.submit();
            });
        });
    });
</script>
}
