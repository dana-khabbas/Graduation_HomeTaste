@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var topDishes = ViewBag.TopDishes as IEnumerable<graduation_proj.Models.Dish>;
    var latestBookings = ViewBag.LatestBookings as IEnumerable<graduation_proj.Models.Booking>;
}

<h1 class="adm-page-title">Dashboard</h1>
<p class="adm-page-subtitle mb-4">Overview of the HomeTaste platform.</p>

<!-- Stat cards: real numbers from the database -->
<div class="row g-4 mb-5">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="adm-stat-card adm-stat-card--accent h-100">
            <p class="adm-stat-label">Total Users</p>
            <h3 class="adm-stat-value adm-stat-value--primary">@ViewBag.TotalUsers</h3>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="adm-stat-card h-100">
            <p class="adm-stat-label">Total Hosts</p>
            <h3 class="adm-stat-value">@ViewBag.TotalHosts</h3>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="adm-stat-card h-100">
            <p class="adm-stat-label">Total Dishes</p>
            <h3 class="adm-stat-value">@ViewBag.TotalDishes</h3>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="adm-stat-card h-100">
            <p class="adm-stat-label">Total Bookings</p>
            <h3 class="adm-stat-value">@ViewBag.TotalBookings</h3>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Top 3 most booked dishes -->
    <div class="col-12 col-lg-6">
        <div class="adm-card">
            <h4 class="adm-card-title mb-4">Top 3 Most Booked Dishes</h4>

            @if (topDishes == null || !topDishes.Any())
            {
                <p class="adm-page-subtitle mb-0">No dishes yet.</p>
            }
            else
            {
                @foreach (var dish in topDishes)
                {
                    <div class="adm-dish-row">
                        <div class="d-flex align-items-center gap-3">
                            <div class="adm-dish-thumb">
                                @if (!string.IsNullOrEmpty(dish.DishPicturePath))
                                {
                                    <img src="@dish.DishPicturePath" alt="@dish.Name" />
                                }
                            </div>
                            <div>
                                <p class="adm-dish-name">@dish.Name</p>
                                <p class="adm-dish-host">Host: @dish.HostProfile?.User?.FullName</p>
                            </div>
                        </div>
                        <div class="text-end">
                            <p class="adm-dish-orders">@dish.TimesBooked</p>
                            <p class="adm-dish-orders-label">Bookings</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Latest 3 bookings -->
    <div class="col-12 col-lg-6">
        <div class="adm-card">
            <h4 class="adm-card-title mb-4">Latest 3 Bookings</h4>

            @if (latestBookings == null || !latestBookings.Any())
            {
                <p class="adm-page-subtitle mb-0">No bookings yet.</p>
            }
            else
            {
                @foreach (var booking in latestBookings)
                {
                    <div class="adm-activity-item mb-3">
                        <div class="adm-activity-icon adm-activity-icon--primary">
                            <span class="material-symbols-outlined">calendar_today</span>
                        </div>
                        <div>
                            <p class="adm-activity-text">
                                <strong>@booking.Guest?.FullName</strong> booked
                                <strong>@booking.Dish?.Name</strong>
                            </p>
                            <p class="adm-activity-time">
                                @booking.VisitDate.ToShortDateString() at @booking.VisitTime
                                • @booking.Status
                            </p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>
