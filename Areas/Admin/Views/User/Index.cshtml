@model IEnumerable<graduation_proj.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
    ViewData["ActivePage"] = "Users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="adm-page-title">Users</h1>
<p class="adm-page-subtitle mb-4">All registered accounts on HomeTaste.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="adm-card">
    <table class="table align-middle mb-0">
        <thead>
            <tr class="adm-dish-host text-uppercase">
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Joined</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-bold">@(user.FullName ?? "—")</td>
                    <td>@(user.PhoneNumber ?? "—")</td>
                    <td>@user.Email</td>
                    <td>@user.JoinedAt.ToShortDateString()</td>
                    <td>
                        @if (user.IsHost)
                        {
                            <span class="badge bg-success">Host</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Guest</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (user.Email != "admin@gmail.com")
                        {
                            <form asp-action="Delete" method="post" class="d-inline js-delete-user">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="adm-btn-danger btn-sm">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    // Ask before deleting a user
    document.querySelectorAll(".js-delete-user").forEach(function (form) {
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            Swal.fire({
                title: "Delete this user?",
                text: "This cannot be undone.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#D17132",
                cancelButtonColor: "#8d7168",
                confirmButtonText: "Yes, delete"
            }).then(function (result) {
                if (result.isConfirmed) form.submit();
            });
        });
    });
</script>
}
