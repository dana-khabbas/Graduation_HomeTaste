<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeTaste Admin</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>

    <!-- Sidebar -->
    <aside class="adm-sidebar d-flex flex-column p-3">

        <div class="mb-4 px-2">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="text-decoration-none">
                <h1 class="adm-brand-name">HomeTaste</h1>
            </a>
            <p class="adm-portal-label">Admin Portal</p>
        </div>

        <nav class="flex-grow-1">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>

            <a href="@Url.Action("Index", "User", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Users" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">group</span>
                <span>Users</span>
            </a>

            <a href="@Url.Action("Index", "Dish", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Dishes" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">restaurant_menu</span>
                <span>Dishes</span>
            </a>

            <a href="@Url.Action("Index", "Review", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Reviews" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">star</span>
                <span>Reviews</span>
            </a>
        </nav>

        <!-- Logout with SweetAlert confirm -->
        <div class="adm-sidebar-footer">
            <form action="/Identity/Account/Logout" method="post" class="d-inline w-100 js-logout-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/" />
                <button type="submit" class="adm-nav-link border-0 bg-transparent w-100 text-start d-flex align-items-center gap-2" style="cursor: pointer;">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </div>

    </aside>

    <div class="adm-main-wrapper">
        <main class="adm-main-content">
            @RenderBody()
        </main>

        <footer class="adm-footer">
            <div class="container-fluid px-4">
                <div class="adm-footer-bar d-flex justify-content-between align-items-center flex-wrap gap-3 py-4">
                    <p class="adm-footer-copy mb-0">© 2024 HomeTaste. Admin Control Panel</p>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll(".js-logout-form").forEach(function (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                Swal.fire({
                    title: "Log out?",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonColor: "#D17132",
                    cancelButtonColor: "#8d7168",
                    confirmButtonText: "Yes, log out",
                    cancelButtonText: "Stay"
                }).then(function (result) {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
