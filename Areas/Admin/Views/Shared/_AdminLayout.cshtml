<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeTaste Admin</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===== SIDEBAR ===== -->
    <aside class="adm-sidebar d-flex flex-column p-3">

        <!-- Brand -->
        <div class="mb-4 px-2">
            <h1 class="adm-brand-name">HomeTaste</h1>
            <p class="adm-portal-label">Admin Portal</p>
        </div>

        <!-- Admin Profile -->
        <div class="d-flex align-items-center gap-3 px-2 mb-4">
            <div class="adm-avatar">
                <span class="material-symbols-outlined">person</span>
            </div>
            <div>
                <p class="adm-welcome-text">Welcome back</p>
                <p class="adm-welcome-sub">Manage your kitchen</p>
            </div>
        </div>

        <!-- Nav Links -->
        <nav class="flex-grow-1">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("Index", "Bookings", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Bookings" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">calendar_today</span>
                <span>Bookings</span>
            </a>
            <a href="@Url.Action("Index", "Dishes", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Dishes" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">restaurant_menu</span>
                <span>Dishes</span>
            </a>
            <a href="@Url.Action("Index", "Reviews", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Reviews" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">star</span>
                <span>Reviews</span>
            </a>
            <a href="@Url.Action("Index", "Settings", new { area = "Admin" })"
               class="adm-nav-link @(ViewData["ActivePage"]?.ToString() == "Settings" ? "adm-nav-link--active" : "")">
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
            </a>
        </nav>

        <!-- Logout -->
        <div class="adm-sidebar-footer">
            <a href="@Url.Action("Logout", "Account", new { area = "Admin" })" class="adm-nav-link">
                <span class="material-symbols-outlined">logout</span>
                <span>Logout</span>
            </a>
        </div>

    </aside>

    <!-- ===== MAIN WRAPPER ===== -->
    <div class="adm-main-wrapper">
        <main class="adm-main-content">
            @RenderBody()
        </main>

        <!-- ===== FOOTER ===== -->
        <footer class="adm-footer">
            <div class="container-fluid px-4">
                <div class="row g-4 py-5">
                    <div class="col-12 col-md-3">
                        <h5 class="adm-footer-brand">HomeTaste</h5>
                        <p class="adm-footer-text mt-3">A warm seat at every table.<br />Admin Control Panel v2.4.1</p>
                    </div>
                    <div class="col-6 col-md-3">
                        <p class="adm-footer-heading">Internal Links</p>
                        <div class="d-flex flex-column gap-2 mt-3">
                            <a href="#" class="adm-footer-link">Safety Guidelines</a>
                            <a href="#" class="adm-footer-link">Host Support</a>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <p class="adm-footer-heading">Legal</p>
                        <div class="d-flex flex-column gap-2 mt-3">
                            <a href="#" class="adm-footer-link">Privacy Policy</a>
                            <a href="#" class="adm-footer-link">Terms of Service</a>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <p class="adm-footer-heading">Contact System Admin</p>
                        <p class="adm-footer-text mt-3">tech-support@hometaste.com</p>
                    </div>
                </div>
                <div class="adm-footer-bar d-flex justify-content-between align-items-center flex-wrap gap-3 py-4">
                    <p class="adm-footer-copy mb-0">© 2024 HomeTaste. A warm seat at every table.</p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined adm-footer-icon">language</span>
                        <span class="adm-footer-copy">EN-US</span>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>